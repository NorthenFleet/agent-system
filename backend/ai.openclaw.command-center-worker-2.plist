<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>ai.openclaw.command-center-worker-2</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>set -a; source ../.env; set +a; export COMMAND_CENTER_WORKER_ID=command-center:worker-2; export COMMAND_CENTER_WORKER_ROLE=dedicated; exec ./venv/bin/python scripts/run_command_center_worker.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/apple/工作桌面/Workspace/agent-system/backend</string>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>/Users/apple/工作桌面/Workspace/agent-system/backend/command-center-worker-2.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/apple/工作桌面/Workspace/agent-system/backend/command-center-worker-2.log</string>
</dict>
</plist>
