{
  "version": "sb3-engineering-v1",
  "provenance": "synthetic_engineering_fixture_not_human_gold",
  "human_reviewed": false,
  "sources": [
    {
      "id": "s00",
      "title": "来源快照",
      "text": "来源快照：导入资料保留固定哈希和原始附件。",
      "language": "zh"
    },
    {
      "id": "s01",
      "title": "发布回滚",
      "text": "发布回滚：纠错需要新修订，不能覆盖历史证据。",
      "language": "zh"
    },
    {
      "id": "s02",
      "title": "审批范围",
      "text": "审批范围：每份修改集绑定审批哈希和基础修订。",
      "language": "zh"
    },
    {
      "id": "s03",
      "title": "中文别名",
      "text": "中文别名：改名后保留旧标题用于查询。",
      "language": "zh"
    },
    {
      "id": "s04",
      "title": "项目隔离",
      "text": "项目隔离：查询前检查用户和项目范围。",
      "language": "zh"
    },
    {
      "id": "s05",
      "title": "访问撤回",
      "text": "访问撤回：来源撤回后拒绝旧知识引用。",
      "language": "zh"
    },
    {
      "id": "s06",
      "title": "概念累积",
      "text": "概念累积：多份来源可以积累到同一个概念页。",
      "language": "zh"
    },
    {
      "id": "s07",
      "title": "关系理由",
      "text": "关系理由：每条知识关系必须保留理由。",
      "language": "zh"
    },
    {
      "id": "s08",
      "title": "文件漂移",
      "text": "文件漂移：发现外部编辑时保留差异并停止覆盖。",
      "language": "zh"
    },
    {
      "id": "s09",
      "title": "引用定位",
      "text": "引用定位：段落引用包含页码或文本行号。",
      "language": "zh"
    },
    {
      "id": "s10",
      "title": "重试预算",
      "text": "重试预算：达到重试上限后进入死信队列。",
      "language": "zh"
    },
    {
      "id": "s11",
      "title": "知识合并",
      "text": "知识合并：合并保留原始页面的历史和来源。",
      "language": "zh"
    },
    {
      "id": "s12",
      "title": "字节校验",
      "text": "字节校验：下载原始附件时验证内容哈希。",
      "language": "zh"
    },
    {
      "id": "s13",
      "title": "指针切换",
      "text": "指针切换：完整文件生成后才能切换当前指针。",
      "language": "zh"
    },
    {
      "id": "s14",
      "title": "人工推论",
      "text": "人工推论：人工编辑后的推论需要明确标记。",
      "language": "zh"
    },
    {
      "id": "s15",
      "title": "Lease fencing",
      "text": "Lease fencing：Expired workers cannot publish late results.",
      "language": "en"
    },
    {
      "id": "s16",
      "title": "Scope policy",
      "text": "Scope policy：A project snapshot must retain its owner and project scope.",
      "language": "en"
    },
    {
      "id": "s17",
      "title": "Context budget",
      "text": "Context budget：Knowledge background has a separate character budget.",
      "language": "en"
    },
    {
      "id": "s18",
      "title": "Atomic release",
      "text": "Atomic release：Reviewed revisions and release manifests commit together.",
      "language": "en"
    },
    {
      "id": "s19",
      "title": "Source provenance",
      "text": "Source provenance：Every statement retains fixed source evidence.",
      "language": "en"
    },
    {
      "id": "s20",
      "title": "日志保留期限旧资料",
      "text": "日志保留期限：规定每 30 天处理一次。",
      "language": "zh"
    },
    {
      "id": "s21",
      "title": "日志保留期限新资料",
      "text": "日志保留期限：规定每 7 天处理一次。",
      "language": "zh"
    },
    {
      "id": "s22",
      "title": "缓存更新间隔旧资料",
      "text": "缓存更新间隔：规定每 30 天处理一次。",
      "language": "zh"
    },
    {
      "id": "s23",
      "title": "缓存更新间隔新资料",
      "text": "缓存更新间隔：规定每 7 天处理一次。",
      "language": "zh"
    },
    {
      "id": "s24",
      "title": "复核执行周期旧资料",
      "text": "复核执行周期：规定每 30 天处理一次。",
      "language": "zh"
    },
    {
      "id": "s25",
      "title": "复核执行周期新资料",
      "text": "复核执行周期：规定每 7 天处理一次。",
      "language": "zh"
    },
    {
      "id": "s26",
      "title": "附件备份频率旧资料",
      "text": "附件备份频率：规定每 30 天处理一次。",
      "language": "zh"
    },
    {
      "id": "s27",
      "title": "附件备份频率新资料",
      "text": "附件备份频率：规定每 7 天处理一次。",
      "language": "zh"
    },
    {
      "id": "s28",
      "title": "运行规范版本旧资料",
      "text": "运行规范版本：规定每 30 天处理一次。",
      "language": "zh"
    },
    {
      "id": "s29",
      "title": "运行规范版本新资料",
      "text": "运行规范版本：规定每 7 天处理一次。",
      "language": "zh"
    }
  ],
