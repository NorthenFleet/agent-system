# ============================================
# API 安全配置示例文件
# 复制为 .env 并修改配置
# ============================================

# 速率限制配置
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100

# API Key 认证配置
# 生产环境请使用强随机密钥
API_KEYS=dashboard-key-001,dashboard-key-002,admin-key-master
AUTH_REQUIRED=false

# 请求日志配置
LOG_FILE_PATH=request_logs.jsonl
LOG_MAX_MEMORY=1000
LOG_INCLUDE_BODY=false

# 异常检测配置
ALERT_FAILED_AUTH=5
ALERT_TIME_WINDOW=300
ALERT_REQUEST_RATE=200

# 告警通知配置
ALERT_EMAIL_ENABLED=false
ALERT_EMAIL_RECIPIENTS=admin@example.com
ALERT_WEBHOOK_URL=

# Redis 配置（可选，用于生产环境）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# 财务生产化配置（生产环境必须使用 PostgreSQL 与独立密钥管理）
DATABASE_URL=postgresql+psycopg2://finance_app:change-me@127.0.0.1:5432/agent_finance
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_SLOW_QUERY_SECONDS=0.5

# 已审核长期记忆向量检索（建议先使用 shadow 模式验证）
MEMORY_VECTOR_ENABLED=false
MEMORY_VECTOR_PREFLIGHT_REQUIRED=false
# 留空时复用 PostgreSQL DATABASE_URL；也可使用独立向量库
MEMORY_VECTOR_DATABASE_URL=
MEMORY_EMBEDDING_HOST=http://127.0.0.1:11434
MEMORY_EMBEDDING_MODEL=nomic-embed-text:v1.5
MEMORY_EMBEDDING_DIM=768
MEMORY_HYBRID_FUSION_MODE=shadow
# 仅临时兼容旧环境；生产应通过迁移建表
MEMORY_VECTOR_RUNTIME_DDL_ENABLED=false
# Shadow 在线指标与观察门禁
MEMORY_SHADOW_METRICS_RETENTION_DAYS=30
MEMORY_SHADOW_MIN_QUERIES=100
MEMORY_SHADOW_VECTOR_AVAILABILITY_TARGET=0.99
MEMORY_SHADOW_VECTOR_P95_MS=300
MEMORY_SHADOW_TOTAL_P95_MS=800
MEMORY_ROLLOUT_MIN_LABELED_CASES=30

# Command Center 事实库；生产多 Worker 使用 PostgreSQL，开发可留空使用 SQLite。
# 切换前必须执行 Alembic upgrade head 和 SQLite 数据迁移预检。
COMMAND_CENTER_DATABASE_URL=postgresql+psycopg2:///team_dashboard
# 每个 Worker 进程的有界连接池；总连接上限=进程数×max。
COMMAND_CENTER_DB_POOL_MIN=1
COMMAND_CENTER_DB_POOL_MAX=10
COMMAND_CENTER_DB_POOL_ACQUIRE_TIMEOUT=5
COMMAND_CENTER_DB_POOL_PRE_PING=true
COMMAND_CENTER_REQUIRED_WORKERS=1
COMMAND_CENTER_WORKER_STALE_SECONDS=20
COMMAND_CENTER_WORKER_HEARTBEAT_SECONDS=5
# Agent Team 默认仅落持久化契约，不接管现有 Mission/WorkRun 主链。
AGENT_TEAM_ENABLED=false
AGENT_TEAM_SHADOW=true
AGENT_TEAM_DYNAMIC_ASSIGNMENT=false
AGENT_TEAM_PEER_MESSAGING=false
AGENT_TEAM_LANGGRAPH=false
# 执行明细与 LangGraph checkpoint 在生产中与 Command Center 共用 PostgreSQL。
WORK_RUN_DATABASE_URL=postgresql+psycopg2:///team_dashboard
COMMAND_CENTER_LANGGRAPH_CHECKPOINT_URL=postgresql:///team_dashboard
# 仅本地 SQLite 开发回退时使用。
COMMAND_CENTER_WORK_RUN_DB_PATH=./data/unified_dashboard.db
COMMAND_CENTER_LANGGRAPH_CHECKPOINT_PATH=./data/command-center-langgraph.sqlite3
# Command Center 高风险步骤与补偿授权有效期（秒）
COMMAND_CENTER_STEP_APPROVAL_TTL=1800
COMMAND_CENTER_COMPENSATION_APPROVAL_TTL=1800

# local 仅供开发；生产建议 s3，兼容 MinIO
FINANCE_STORAGE=local
FINANCE_OBJECT_ROOT=./data/finance-objects
FINANCE_ATTACHMENT_MAX_BYTES=20971520
FINANCE_S3_ENDPOINT=http://127.0.0.1:9000
FINANCE_S3_REGION=us-east-1
FINANCE_S3_BUCKET=finance-private
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

# 外部能力通过适配器配置；未配置时自动进入人工复核
FINANCE_OCR_ADAPTER=manual
FINANCE_VERIFICATION_ADAPTER=manual
