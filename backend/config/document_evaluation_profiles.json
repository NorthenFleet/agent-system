    {
      "id": "rich_text.doctoral.v1",
      "name": "通用博士论文评价标准",
      "version": "1.0.0",
      "kind": "rich_text",
      "document_types": ["博士论文"],
      "pass_threshold": 80,
      "dimensions": [
        {"id": "topic_value", "name": "选题价值与问题定义", "weight": 8, "min_score": 60, "source": "ai", "description": "研究问题的重要性、边界和可研究性"},
        {"id": "literature_review", "name": "国内外研究现状", "weight": 10, "min_score": 60, "source": "ai", "description": "文献准确性、时效性、观点归纳和研究空白"},
        {"id": "theory", "name": "理论体系", "weight": 12, "min_score": 60, "source": "ai", "description": "概念、假设、模型和理论关系的完整性"},
        {"id": "method", "name": "方法设计", "weight": 15, "min_score": 70, "source": "ai", "description": "方法合理性、完整性、可实现性和适用边界"},
        {"id": "innovation", "name": "创新性", "weight": 18, "min_score": 70, "source": "ai", "description": "原创贡献的明确性、载体和可验证性"},
        {"id": "evidence", "name": "实验与证据", "weight": 17, "min_score": 70, "source": "ai", "description": "基线、对照、指标、实验结果和证据强度"},
        {"id": "argument_closure", "name": "论证闭环", "weight": 10, "min_score": 70, "source": "ai", "description": "研究问题、方法、结果和结论的逐项对应"},
        {"id": "writing", "name": "写作表达", "weight": 5, "min_score": 60, "source": "ai", "description": "学术语言的准确性、清晰度和一致性"},
        {"id": "traceability", "name": "规范与可追溯性", "weight": 5, "min_score": 60, "source": "mixed", "description": "引用、图表、公式、版本和数据的可追溯性"}
      ],
      "gates": [
        {"id": "structure_complete", "name": "结构完整", "source": "automatic", "required": true, "critical": false},
        {"id": "problem_closure", "name": "问题闭环", "source": "ai", "required": true, "critical": false},
        {"id": "innovation_explicit", "name": "创新明确", "source": "ai", "required": true, "critical": false},
        {"id": "evidence_complete", "name": "证据完整", "source": "ai", "required": true, "critical": false},
        {"id": "experiment_valid", "name": "实验有效", "source": "ai", "required": true, "critical": false},
        {"id": "citation_compliant", "name": "引用合规", "source": "automatic", "required": true, "critical": false},
        {"id": "figures_complete", "name": "图表完整", "source": "automatic", "required": true, "critical": false},
        {"id": "consistent", "name": "前后一致", "source": "ai", "required": true, "critical": false},
        {"id": "format_compliant", "name": "格式合规", "source": "human", "required": true, "critical": false},
        {"id": "academic_ethics", "name": "学术伦理确认", "source": "external", "required": true, "critical": true}
      ],
      "maturity_labels": ["材料汇集", "结构草稿", "正文完整", "内审合格", "送审就绪", "答辩就绪"]
    },
